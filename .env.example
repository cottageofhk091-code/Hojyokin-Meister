# Google AI Studio で発行した Gemini API キーを入力してください
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe Checkout（プレミアム 980円・税込 / 1回払い）
# Stripe ダッシュボードの価格も 980円（税込）に合わせてください
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_WEBHOOK_SECRET=

# アプリ公開URL（重複定義しない）
# ローカル開発: http://localhost:3000
# 本番: Vercel の Environment Variables に https://hojyokin-meister-1.vercel.app を1つだけ設定
NEXT_PUBLIC_APP_URL=http://localhost:3000

# メール送信（Resend）
AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=AI補助金マイスター <onboarding@resend.dev>
AUTH_EMAIL_FROM=AI補助金マイスター <onboarding@resend.dev>

# メールアドレスをキーにした骨子・課金データの保存先（未設定なら ./data）
# DATA_DIR=

# GA4 Measurement Protocol（サーバー側イベント送信）
NEXT_PUBLIC_GA_ID=
GA4_API_SECRET=

# Supabase（Auth / profiles / analytics）
# URL と anon/publishable は公開用。service_role / sb_secret_ はサーバー専用。
# Authentication → URL Configuration:
#   Site URL: https://hojyokin-meister-1.vercel.app
#   Redirect URLs: https://hojyokin-meister-1.vercel.app/**
#                 https://hojyokin-meister-1.vercel.app/auth/callback
#                 https://hojyokin-meister-1.vercel.app/auth/reset-password
#                 https://hojyokin-meister-1.vercel.app/api/auth/verify-reset
#                 http://localhost:3000/**
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
