# Google AI Studio で発行した Gemini API キーを入力してください
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe Checkout（プレミアム 980円・税込 / 1回払い）
# Stripe ダッシュボードの価格も 980円（税込）に合わせてください
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# メール OTP 認証（Resend）
AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=AI補助金マイスター <onboarding@resend.dev>

# メールアドレスをキーにした骨子・課金データの保存先（未設定なら ./data）
# DATA_DIR=

# GA4 Measurement Protocol（サーバー側イベント送信）
NEXT_PUBLIC_GA_ID=
GA4_API_SECRET=

# Supabase（app_logs へのサーバー側ログ）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
